{
  "name": "daemoncore-academy",
  "private": true,
  "type": "module",
  "version": "1.7.0",
  "description": "A sealed cyber range and operator training desktop platform.",
  "main": "electron/main.cjs",
  "author": "DaemonCore Academy",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:win:from-unpacked": "node scripts/prepare-unpacked.mjs && electron-builder --win nsis --prepackaged release/win-unpacked",
    "icon": "node scripts/generate-icon.mjs",
    "check": "eslint src",
    "check:data": "node scripts/verify-data-store.mjs",
    "check:phase4": "node scripts/verify-phase4.mjs",
    "check:phase5": "node scripts/verify-phase5.mjs",
    "check:phase6": "node scripts/verify-phase6.mjs",
    "check:phase7": "node scripts/verify-phase7.mjs",
    "check:phase8": "node scripts/verify-phase8.mjs",
    "check:range": "node scripts/verify-range.mjs",
    "test": "npm run check && npm run check:data && npm run check:phase4 && npm run check:phase5 && npm run check:phase6 && npm run check:phase7 && npm run check:phase8 && npm run check:range && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@eslint/js": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.4",
    "wait-on": "latest"
  },
  "build": {
    "appId": "academy.daemoncore.desktop",
    "productName": "DaemonCore Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ranges",
        "to": "ranges"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "DaemonCore-Academy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
