{
  "name": "daemoncore-academy",
  "private": true,
  "type": "module",
  "version": "6.4.0",
  "description": "A sealed cyber range and operator training desktop platform.",
  "desktopName": "daemoncore-academy.desktop",
  "main": "electron/main.cjs",
  "author": {
    "name": "DaemonCore Apps",
    "email": "DaemoncoreApps@users.noreply.github.com"
  },
  "homepage": "https://academy.daemoncore.app",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:store": "npm run build && electron-builder --win appx --publish never",
    "package:win:from-unpacked": "node scripts/prepare-unpacked.mjs && electron-builder --win nsis --prepackaged release/win-unpacked",
    "package:linux": "npm run icon && npm run build && electron-builder --linux AppImage deb --publish never",
    "icon": "node scripts/generate-icon.mjs",
    "check": "eslint src",
    "check:data": "node scripts/verify-data-store.mjs",
    "check:phase4": "node scripts/verify-phase4.mjs",
    "check:phase5": "node scripts/verify-phase5.mjs",
    "check:phase6": "node scripts/verify-phase6.mjs",
    "check:phase7": "node scripts/verify-phase7.mjs",
    "check:phase8": "node scripts/verify-phase8.mjs",
    "check:phase11": "node scripts/verify-phase11.mjs",
    "check:phase12": "node scripts/verify-phase12.mjs",
    "check:phase13": "node scripts/verify-phase13.mjs",
    "check:phase14": "node scripts/verify-phase14.mjs",
    "check:phase15": "node scripts/verify-phase15.mjs",
    "check:phase16": "node scripts/verify-phase16.mjs",
    "check:fieldops": "node scripts/verify-fieldops-workspace.mjs",
    "check:campaigns": "node scripts/verify-campaign-engine.mjs",
    "check:trust": "node scripts/verify-trust-authority.mjs",
    "check:tool-bridge": "node scripts/verify-tool-bridge.mjs",
    "check:fabric": "node scripts/verify-execution-fabric.mjs",
    "check:native-runner": "node scripts/verify-native-runner.mjs",
    "check:installer": "node scripts/verify-installer.mjs",
    "check:linux": "node scripts/verify-linux.mjs",
    "check:mission-os": "node scripts/verify-mission-os.mjs",
    "check:usability": "node scripts/verify-usability.mjs",
    "check:persistence": "node scripts/verify-desktop-persistence.mjs",
    "check:certification": "node scripts/verify-certification.mjs",
    "certify:identity": "node scripts/certify-identity-range.mjs",
    "check:range": "node scripts/verify-range.mjs",
    "test": "npm run check && npm run check:data && npm run check:phase4 && npm run check:phase5 && npm run check:phase6 && npm run check:phase7 && npm run check:phase8 && npm run check:phase11 && npm run check:phase12 && npm run check:phase13 && npm run check:phase14 && npm run check:phase15 && npm run check:phase16 && npm run check:fieldops && npm run check:campaigns && npm run check:trust && npm run check:tool-bridge && npm run check:fabric && npm run check:native-runner && npm run check:installer && npm run check:linux && npm run check:range && npm run check:mission-os && npm run check:usability && npm run check:persistence && npm run check:certification && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@eslint/js": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.4",
    "wait-on": "latest"
  },
  "build": {
    "appId": "academy.daemoncore.desktop",
    "productName": "DaemonCore Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ranges",
        "to": "ranges"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "DaemonCore-Academy-Setup.${ext}"
    },
    "appx": {
      "identityName": "DaemonCore.DaemoncoreAcademy-CyberSecurity",
      "publisher": "CN=B7B53B09-651D-4171-90BE-4E9E1F5738BA",
      "publisherDisplayName": "DaemonCore",
      "displayName": "Daemoncore Academy - Cyber Security",
      "applicationId": "DaemonCoreAcademy",
      "languages": [
        "en-US"
      ],
      "artifactName": "DaemonCore-Academy-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "DaemonCore-Academy-${version}.${ext}",
      "category": "Education",
      "icon": "build/icons",
      "executableName": "daemoncore-academy",
      "syncDesktopName": true,
      "synopsis": "Sealed cyber ranges and authorization-bound assessment operations",
      "description": "DaemonCore Academy combines practical security instruction, disposable Docker ranges, and the FieldOps evidence workspace in one local-first desktop application."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "DaemonCore Academy",
      "include": "build/installer.nsh"
    }
  }
}
