#!/bin/sh
set -eu
finding="${1:-}"
if [ "$finding" = "delegated backup service account expands administrative reach" ]; then
  printf '%s\n' 'FINDING ACCEPTED' 'Protocol evidence: DNS + Kerberos + LDAP VERIFIED' 'Boundary: DAEMONCORE.LAB SEALED' 'Impact ceiling: designated lab group only'
  exit 0
fi
printf '%s\n' 'CONDITION REJECTED' 'Name the designated service identity, delegated group, and bounded reach.' >&2
exit 2
