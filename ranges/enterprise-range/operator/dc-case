#!/bin/sh
set -eu
case_id="${1:-}"
phase="${2:-}"
if ! printf '%s' "$case_id" | grep -Eq '^[a-z]+-[0-9]{2}$'; then echo 'usage: dc-case <case-id> <scope|baseline|compare>' >&2; exit 2; fi
if ! printf '%s' "$phase" | grep -Eq '^(scope|baseline|compare)$'; then echo 'phase must be scope, baseline, or compare' >&2; exit 2; fi
jq --arg id "$case_id" --arg phase "$phase" -e '.[] | select(.id==$id) | {case:.id,title,category,phase:$phase,evidence:.[ $phase ]}' /opt/enterprise/cases.json
